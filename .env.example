# Copy to .env.local for local development. Real values live in Vercel →
# Settings → Environment Variables. Never commit real values.

# ── Admin panel (/admin) ────────────────────────────────────────────────
# The committee password. Changing it logs every device out.
ADMIN_PASSWORD=
# Random string, at least 32 characters. Generate with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ── Event storage (Upstash Redis) ───────────────────────────────────────
# Added automatically when an Upstash Redis database is connected to the
# project in Vercel → Storage. Leave empty locally to use .data/events.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Careers board (optional) ────────────────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Instagram feed (optional) ───────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=

# ── Custom domain (set LAST, once astonisoc.com loads the site) ─────────
# NEXT_PUBLIC_SITE_URL=https://astonisoc.com
